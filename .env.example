# AuthWho configuration. Dummy values only: copy to .env and replace every
# value. Generate a 32-byte base64 key with:
#   .venv/Scripts/python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"

# PostgreSQL container (read by docker-compose.yml). Must match AUTHWHO_DATABASE_URL.
POSTGRES_USER=authwho
POSTGRES_PASSWORD=dummy-change-me
POSTGRES_DB=authwho

# AuthWho server and worker
AUTHWHO_DATABASE_URL=postgresql://authwho:dummy-change-me@127.0.0.1:5432/authwho
AUTHWHO_REDIS_URL=redis://127.0.0.1:6379/0
# 32 bytes, base64. This dummy decodes to "dummy-authwho-data-key-32-bytes!"
AUTHWHO_DATA_KEY=ZHVtbXktYXV0aHdoby1kYXRhLWtleS0zMi1ieXRlcyE=
AUTHWHO_APP_API_KEY=dummy-app-api-key
AUTHWHO_ADMIN_TOKEN=dummy-admin-token
AUTHWHO_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Demo app backend
AUTHWHO_COLLECTOR_URL=http://127.0.0.1:8000
DEMO_DB_PATH=data/demo/demo.sqlite
DEMO_SECRET_KEY=dummy-demo-secret-key
# 32 bytes, base64. This dummy decodes to "dummy-demo-totp-key-32-bytes-ok!"
DEMO_TOTP_KEY=ZHVtbXktZGVtby10b3RwLWtleS0zMi1ieXRlcy1vayE=

# Volunteer research export. 32 bytes, base64.
# This dummy decodes to "dummy-research-export-key-32byte"
RESEARCH_EXPORT_KEY=ZHVtbXktcmVzZWFyY2gtZXhwb3J0LWtleS0zMmJ5dGU=
DEMO_WITHDRAWAL_RETRY_SECONDS=300
AUTHWHO_ENROLL_WINDOWS=20
